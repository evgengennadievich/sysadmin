{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/red-zone-guard.sh\"; if [ -f \"$g\" ]; then bash \"$g\"; else cat >/dev/null; fi",
            "timeout": 15,
            "statusMessage": "Проверяю зону операции…"
          }
        ]
      }
    ]
  }
}

#!/usr/bin/env bash
# Подставной ssh для регрессионных тестов audit-security.
#
# Зачем: дефекты, которые тесты стерегут, проявляются ТОЛЬКО в связке
# «локальная логика скрипта + поведение удалённой команды». Проверить их без
# сервера можно единственным способом — подменив сам транспорт.
#
# Что делает:
#   1) отбрасывает опции ssh и адрес сервера;
#   2) обрабатывает префикс `sudo -n` — при STUB_SUDO=deny отказывает ровно так
#      же, как настоящий sudo: код 1 и сообщение в stderr (это принципиально —
#      именно неотличимость этой единицы от grep-«ничего не найдено» и была
#      корнем дефектов);
#   3) выполняет команду локально, подставив в PATH заглушки серверных утилит.
set -u

args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -o) shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done

CMD="${args[1]:-}"

case "$CMD" in
    "sudo -n "*)
        if [ "${STUB_SUDO:-allow}" = "deny" ]; then
            echo "sudo: a password is required" >&2
            exit 1
        fi
        CMD="${CMD#sudo -n }"
        export STUB_AS_ROOT=1
        ;;
esac

# Системные пути подменяются фикстурами: тест не должен зависеть от того, что
# лежит в /etc на машине, где его запускают.
# Подстановку делает sed, а не ${var//.../...}: шаблон, начинающийся со слэша,
# в этой конструкции разбирается как пустой, и замена вклинивается между каждыми
# двумя символами строки. Поймано собственным тестом при первом же прогоне.
# Порядок правил значим: sudoers.d обрабатывается раньше sudoers.
if [ -n "${STUB_FIX:-}" ]; then
    CMD=$(printf '%s' "$CMD" | sed \
        -e "s|/etc/sudoers\.d|$STUB_FIX/sudoers.d|g" \
        -e "s|/etc/sudoers|$STUB_FIX/sudoers|g")
fi

export PATH="${STUB_BIN:?STUB_BIN не задан}:$PATH"
exec sh -c "$CMD"

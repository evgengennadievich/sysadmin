#!/bin/sh
# Заглушка openssl.
#
#   version   — отвечает как настоящий; при STUB_OPENSSL=missing выходит с 127,
#               то есть изображает «утилиты на сервере нет». Через этот вызов
#               скрипт решает, откуда проверять TLS, поэтому подменяем именно его.
#   s_client  — не отдаёт сертификат (сценарий «на 443 не веб-сервер»)
#               и выходит с НЕНУЛЕВЫМ кодом. Это принципиально: такой код —
#               законный ответ openssl, а не сбой выполнения, и прежде скрипт
#               путал одно с другим и молча уходил на локальный прогон.
#   остальное — настоящему openssl: разбор даты должен работать по-честному.
case "${1:-}" in
    version)
        [ "${STUB_OPENSSL:-present}" = "missing" ] && exit 127
        exec /usr/bin/openssl "$@" ;;
    s_client) exit 1 ;;
    *) exec /usr/bin/openssl "$@" ;;
esac
